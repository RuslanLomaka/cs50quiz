[Unit]
Description=QuizForger Django app
After=network.target

[Service]
User=quizforger
Group=quizforger
WorkingDirectory=/srv/quizforger/app
EnvironmentFile=/etc/quizforger/quizforger.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/srv/quizforger/app/.venv/bin/python manage.py check_database
ExecStartPre=/srv/quizforger/app/.venv/bin/python manage.py check_quizzes
ExecStart=/srv/quizforger/app/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 2 --timeout 60 --graceful-timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
TimeoutStopSec=70
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/quizforger/app /etc/quizforger/quizforger.env
ReadWritePaths=/var/lib/quizforger

[Install]
WantedBy=multi-user.target
